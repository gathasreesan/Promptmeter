# Dependencies — reproducible from dashboard/package-lock.json via `npm install`
node_modules/

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# Logs
*.log
npm-debug.log*

# Python bytecode from the ML trainer
__pycache__/
*.pyc

# Local MCP server registration. It names headroom.exe by absolute path under this
# machine's Python user-scripts directory, so committing it would hand everyone else
# a path that does not exist. Recreate it per machine, or run `headroom mcp install`.
.mcp.json

# generation checkpoint, not a deliverable
ml/dataset/.synthetic_raw.jsonl

# Reference corpus: regenerate with ml/ingest.py rather than committing 29MB
# of Parquet and the raw Hugging Face downloads beside it.
ml/corpus/

# A zipped copy of dashboard/node_modules. The live directory is already ignored
# above and rebuilds with `npm install`, so the archive is a 6.9MB duplicate of
# something reproducible. Ignored rather than deleted: it is not mine to remove.
dashboard/node_modules.zip
